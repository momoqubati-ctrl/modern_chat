# ==========================================
# NewChat Configuration (Local No-Docker)
# ==========================================

NODE_ENV=development
API_PORT=3003
GATEWAY_PORT=3004
WEB_PORT=5173

# PostgreSQL (Supabase / Render / Local)
# For Supabase Pooler: postgresql://postgres.<PROJECT-REF>:<PASSWORD>@<POOLER-HOST>:6543/postgres
#DATABASE_URL=postgresql://postgres.lccvkwdfllyzfgveprod:YOUR_POSTGRES_PASSWORD@aws-1-ap-northeast-2.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/newchat
PG_POOL_MAX=30

# Memurai / Redis (Local Windows Service on 6379)
REDIS_URL=redis://127.0.0.1:6379
SOCKET_REDIS_ENABLED=0

# Legacy MySQL (XAMPP Source for Migration)
LEGACY_MYSQL_HOST=127.0.0.1
LEGACY_MYSQL_PORT=3308
LEGACY_MYSQL_USER=root
LEGACY_MYSQL_PASS=
LEGACY_MYSQL_DB=safarihost

# Security & Auth
JWT_SECRET=change-this-to-a-long-random-secret-key-min-32-chars
JWT_REFRESH_SECRET=change-this-refresh-secret-min-32-chars
SECRET_COINS_KEY=q8R2mN7vL5xT1kH9zP4cW6eF3yU0aD

# Owner & System Accounts
APP_OWNER_USERNAME=chatmaster11
APP_OWNER_PASSWORD=roneasmaa5052
APP_OWNER2_USERNAME=chatmaster
APP_OWNER2_PASSWORD=sssaaa7412

# Real-Time & LiveKit
UWS_ENABLED=0
UWS_PORT=9443
LIVEKIT_WS_URL=wss://group-z3b4iud3.livekit.cloud
LIVEKIT_API_KEY=APIcPXnBsqFwFrB---
